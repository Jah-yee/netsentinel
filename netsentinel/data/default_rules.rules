# netsentinel default signature set (Suricata-style subset).
# Offline, fixture-driven. Placeholders use RFC 5737 documentation ranges only.
# ---
alert tcp any any -> any any (msg:"[netsentinel] Lab NMAP-style SYN scan (threshold)"; flags:S; threshold:20; sid:1000001; rev:1; severity:2; classtype:attempted-recon; reference:url,https://en.wikipedia.org/wiki/Nmap)
alert tcp any any -> any any (msg:"[netsentinel] Suspicious JPEG-magic artifact in flow"; content:"|ff d8 ff e0|"; sid:1000002; rev:1; severity:2; classtype:misc-attack)
alert tcp any any -> any any (msg:"[netsentinel] Exploit probe shellcode marker"; content:"SHELL!"; sid:1000003; rev:1; severity:2; classtype:misc-attack)
alert tcp any any -> any any (msg:"[netsentinel] SQL tautology injection probe"; content:"OR 1=1--"; sid:1000004; rev:1; severity:3; classtype:web-application-attack; reference:url,https://owasp.org/www-community/attacks/SQL_Injection)
alert udp any any -> any any (msg:"[netsentinel] SMB-over-UDP probe"; content:"|ff 53 4d 42|"; sid:1000005; rev:1; severity:3; classtype:attempted-recon)
alert udp any any -> any 53 (msg:"[netsentinel] DNS query observed (informational)"; content:"|01 00 00 01|"; sid:1000006; rev:1; severity:3; classtype:not-suspicious)